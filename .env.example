# Clerk Configuration (Required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# API Configuration (Required)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Map Configuration (Required)
NEXT_PUBLIC_MAP_STYLE_URL=/api/maps/style.json

# Map Configuration (Optional with defaults)
NEXT_PUBLIC_MAP_GLYPHS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf
NEXT_PUBLIC_MAP_SPRITE_URL=https://protomaps.github.io/basemaps-assets/sprites/v4/light
NEXT_PUBLIC_DEFAULT_MAP_LONGITUDE=139.767
NEXT_PUBLIC_DEFAULT_MAP_LATITUDE=35.681
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=15
NEXT_PUBLIC_DEFAULT_MAP_HEIGHT=480px

# Environment
NODE_ENV=development